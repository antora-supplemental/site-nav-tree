{{!
  Companion partial for Valentus when @antora-supplemental/site-nav-tree is on.
  Component titles live in the tree roots - do not also print valentus-nav-component-title.
  Keeps stock nav-tree partial + Default UI / Valentus expand-collapse JS.
}}
<div class="nav-panel-menu is-active" data-panel="menu">
  {{#if site.keys.site_nav_tree_filter}}
  <div class="nav-tree-filter">
    <input
      class="nav-tree-filter-input"
      type="search"
      autocomplete="off"
      spellcheck="false"
      aria-label="Filter navigation"
      placeholder="Filter navigation…"
      data-nav-tree-filter>
  </div>
  {{/if}}
  <nav class="nav-menu nav-tree-only valentus-nav-tree-only" aria-label="Site documentation">
    <button class="nav-menu-toggle" aria-label="Toggle expand and collapse of all item groups" style="display: none"></button>
    {{#with page.navigation}}
    {{> nav-tree navigation=this}}
    {{/with}}
  </nav>
</div>
